---
import { siteConfig } from '../data/site';
import { withBase } from '../utils/paths';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">{siteConfig.shortName} <span>Portfolio</span></div>
    <nav class="site-footer__nav" aria-label="Footer">
      <a href={withBase('/')}>Home</a>
      <a href={withBase('/blog')}>Writing</a>
      <a href={withBase('/work')}>Work</a>
      <a href={withBase('/about')}>About</a>
      <a href={withBase('/contact')}>Contact</a>
      <a href={siteConfig.cvHref} target="_blank" rel="noreferrer">
        {siteConfig.cvLabel}
      </a>
      <a href={withBase('/rss.xml')}>RSS</a>
    </nav>
    <div class="site-footer__meta">
      <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      <span>·</span>
      <a href={siteConfig.github} target="_blank" rel="noreferrer">GitHub</a>
      <span>·</span>
      <a href={siteConfig.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      <span>·</span>
      <span>© {year} {siteConfig.name}</span>
    </div>
  </div>
</footer>
