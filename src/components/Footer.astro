---
import { siteConfig } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">{siteConfig.shortName} <span>Portfolio</span></div>
    <nav class="site-footer__nav" aria-label="Footer">
      <a href="/">Home</a>
      <a href="/blog">Writing</a>
      <a href="/work">Work</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href={siteConfig.cvHref} target="_blank" rel="noreferrer">
        {siteConfig.cvLabel}
      </a>
      <a href="/rss.xml">RSS</a>
    </nav>
    <div class="site-footer__meta">
      <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      <span>·</span>
      <a href={siteConfig.github} target="_blank" rel="noreferrer">GitHub</a>
      <span>·</span>
      <a href={siteConfig.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      <span>·</span>
      <span>© {year} {siteConfig.name}</span>
    </div>
  </div>
</footer>
