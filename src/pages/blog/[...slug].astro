---
import { getCollection, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { siteConfig } from '../../data/site';
import { withBase } from '../../utils/paths';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
    (a, b) => +b.data.date - +a.data.date,
  );

  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: posts[i + 1],
      next: posts[i - 1],
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  `${String(d.getDate()).padStart(2, '0')}.${String(d.getMonth() + 1).padStart(2, '0')}.${d.getFullYear()}`;
---

<PageLayout
  title={post.data.bigTitle}
  description={post.data.excerpt}
  eyebrow={post.data.course}
  heroImage={post.data.cover}
  pageTitle={`${post.data.title} — ${siteConfig.name}`}
>
  <div class="post-meta">
    <span>{post.data.postType}</span>
    <span>{fmt(post.data.date)}</span>
    <span>{post.data.readTime}</span>
  </div>

  <div class="project-meta">
    <div class="project-meta__row">
      <strong>Course</strong>
      <span>{post.data.course}</span>
    </div>
    {
      post.data.context && (
        <div class="project-meta__row">
          <strong>Context</strong>
          <span>{post.data.context}</span>
        </div>
      )
    }
    {
      post.data.status && (
        <div class="project-meta__row">
          <strong>Status</strong>
          <span>{post.data.status}</span>
        </div>
      )
    }
  </div>

  <div class="project-actions">
    <a href={post.data.repoUrl} target="_blank" rel="noreferrer"> View GitHub Repository </a>
    {
      post.data.demoUrl && (
        <a href={post.data.demoUrl} target="_blank" rel="noreferrer">
          Open Live Demo
        </a>
      )
    }
  </div>

  {
    post.data.tags.length > 0 && (
      <div class="tag-list" style="margin-top: 24px;">
        {post.data.tags.map((tag) => (
          <a href={withBase(`/tags/${tag}`)}>{tag}</a>
        ))}
      </div>
    )
  }

  <hr style="border:0;border-top:1px solid #94918f;margin:32px 0;" />

  <div class="prose">
    <Content />
  </div>

  <nav class="post-nav" aria-label="Adjacent case studies">
    {
      prev ? (
        <a class="post-nav__prev" href={withBase(`/blog/${prev.id}`)}>
          <span>← Previous</span>
          <strong>{prev.data.bigTitle}</strong>
        </a>
      ) : (
        <span />
      )
    }
    {
      next ? (
        <a class="post-nav__next" href={withBase(`/blog/${next.id}`)}>
          <span>Next →</span>
          <strong>{next.data.bigTitle}</strong>
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</PageLayout>
