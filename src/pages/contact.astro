---
import PageLayout from '../layouts/PageLayout.astro';
import { siteConfig } from '../data/site';
---

<PageLayout
  title="Contact"
  eyebrow="Say hello"
  description="The simplest version is best on GitHub Pages: direct links, email, and a clear way to reach you."
>
  <div class="prose">
    <p>
      Email me at <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>. You can also find
      me on <a href={siteConfig.github} target="_blank" rel="noreferrer">GitHub</a> and
      <a href={siteConfig.linkedin} target="_blank" rel="noreferrer"> LinkedIn</a>.
    </p>
    <p>
      If you want a contact form later, connect this page to Formspree or another form backend.
      For now, direct contact is more reliable than a static mail form.
    </p>
    <ul>
      <li><strong>Role:</strong> {siteConfig.role}</li>
      <li><strong>Location:</strong> {siteConfig.location}</li>
      <li><strong>Email:</strong> <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></li>
    </ul>
  </div>
</PageLayout>
