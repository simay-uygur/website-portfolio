---
import PageLayout from '../layouts/PageLayout.astro';
import { siteConfig } from '../data/site';
---

<PageLayout
  title="Contact"
  eyebrow="Say hello"
  description="The best way to reach me is by email. You can also use my GitHub, LinkedIn, and CV links below."
>
  <div class="prose">
    <p>
      If you want to talk about internships, junior developer roles, collaborations, or a specific
      project, email is the best way to reach me.
    </p>
    <p>
      This site collects my projects, coursework, technical writing, and portfolio material. If you
      want a quick overview before reaching out, you can also open my
      <a href={siteConfig.cvHref} target="_blank" rel="noreferrer"> CV</a>.
    </p>

    <ul>
      <li><strong>Role:</strong> {siteConfig.role}</li>
      <li><strong>Location:</strong> {siteConfig.location}</li>
      <li><strong>Email:</strong> <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></li>
      <li>
        <strong>GitHub:</strong>{' '}
        <a href={siteConfig.github} target="_blank" rel="noreferrer">
          {siteConfig.github.replace('https://', '')}
        </a>
      </li>
      <li>
        <strong>LinkedIn:</strong>{' '}
        <a href={siteConfig.linkedin} target="_blank" rel="noreferrer">
          {siteConfig.linkedin.replace('https://www.', '')}
        </a>
      </li>
      <li>
        <strong>CV:</strong>{' '}
        <a href={siteConfig.cvHref} target="_blank" rel="noreferrer">
          {siteConfig.cvLabel}
        </a>
      </li>
    </ul>
  </div>
</PageLayout>
