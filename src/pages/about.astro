---
import PageLayout from '../layouts/PageLayout.astro';
import { siteConfig } from '../data/site';
---

<PageLayout title="About Me" eyebrow="Profile" description={siteConfig.aboutIntro}>
  <div class="prose">
    {siteConfig.aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}

    <p>
      You can also download my <a href={siteConfig.cvHref} target="_blank" rel="noreferrer">CV</a>
      for a compact summary of experience, coursework, and projects.
    </p>

    <h2>What This Site Is For</h2>
    <p>
      This site is where I organize the work I want to present clearly: backend-focused projects,
      course-based engineering work, machine learning assignments, selected full-stack builds, and
      the GitHub repositories or reports behind them.
    </p>

    <h2>Focus Areas</h2>
    <ul>
      {siteConfig.strengths.map((item) => <li>{item}</li>)}
    </ul>

    <h2>Experience</h2>
    {
      siteConfig.experience.map((entry) => (
        <section class="experience-entry">
          <h3>
            {entry.role} - {entry.organization}
          </h3>
          <p>
            {entry.team ? `${entry.team} · ` : ''}
            {entry.period} · {entry.location}
          </p>
          <ul>
            {entry.details.map((detail) => (
              <li>{detail}</li>
            ))}
          </ul>
        </section>
      ))
    }

    <h2>Links</h2>
    <ul>
      <li>
        <strong>Email:</strong>
        <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      </li>
      <li>
        <strong>GitHub:</strong>{' '}
        <a href={siteConfig.github} target="_blank" rel="noreferrer">
          {siteConfig.github.replace('https://', '')}
        </a>
      </li>
      <li>
        <strong>LinkedIn:</strong>{' '}
        <a href={siteConfig.linkedin} target="_blank" rel="noreferrer">
          {siteConfig.linkedin.replace('https://www.', '')}
        </a>
      </li>
    </ul>

    <h2>Quick Facts</h2>
    <ul>
      <li><strong>Name:</strong> {siteConfig.name}</li>
      <li><strong>Role:</strong> {siteConfig.role}</li>
      <li><strong>Location:</strong> {siteConfig.location}</li>
    </ul>
  </div>
</PageLayout>
